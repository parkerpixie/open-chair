{
  "expo": {
    "name": "Open Chair",
    "slug": "open-chair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/OpenChairAppIcon.png",
    "scheme": "openchair",
    "userInterfaceStyle": "light",
    "owner": "capyqueue-systems-for-humans",
    "ios": {
      "icon": "./assets/images/OpenChairAppIcon.png",
      "bundleIdentifier": "com.undergrowth.openchair",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F4E3",
          "image": "./assets/images/OpenChairOpenScreen.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8d801d77-5ef9-45bc-aa16-51188735b27c"
      }
    }
  }
}
